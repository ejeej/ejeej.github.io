@ARTICLE{Альм Клин Мед17669,
	author = {Славенко, Матвей Григорьевич and Мироненко, Ольга Николаевна and Кузнецов, Максим Сергеевич and Бакин, Евгений Александрович},
	title = {Мифологизация статистики в биомедицинских исследованиях},
